# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (use a dev branch locally).
DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# GitHub OAuth app (github.com/settings/developers). Callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Only this GitHub username can sign in and write.
OWNER_GITHUB_LOGIN="s-samarth"

# Vercel Blob token for image uploads (vercel.com → Storage → Blob).
BLOB_READ_WRITE_TOKEN=""

# Salt for hashing visitor IPs in analytics. Any long random string.
ANALYTICS_SALT=""

# Public URL of the site, used for share links, RSS and OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
