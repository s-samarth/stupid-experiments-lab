# Copy to .env.local and fill in. Never commit .env.local.

# Supabase Postgres: Project → Connect → "Transaction pooler" string (port 6543).
# Replace [YOUR-PASSWORD] with your database password.
DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
# GitHub OAuth app (github.com/settings/developers). Callback: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Only this GitHub username can sign in and write.
OWNER_GITHUB_LOGIN="s-samarth"

# Vercel Blob token for image uploads (vercel.com → Storage → Blob).
BLOB_READ_WRITE_TOKEN=""

# Salt for hashing visitor IPs in analytics. Any long random string.
ANALYTICS_SALT=""

# Public URL of the site, used for share links, RSS and OG images.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Protects the daily keep-alive cron. Any long random string (Vercel sends it automatically).
CRON_SECRET=""
